node_modules
.pnpm-store
dist
coverage
src/generated

# Local configuration can contain secrets.
.env
.env.*
!.env.example

# Source control and local agent configuration are not needed to build the API.
.git
.agents
.claude
.codex
.github

# Local tooling, documentation, and logs are not runtime build inputs.
docs
*.md
*.log
compose.yaml
